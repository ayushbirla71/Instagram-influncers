# Copy to .env (local) or set in your host's environment settings (production). Never commit real values.

# --- Database (Postgres). Neon/Supabase give you this URL. ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Public URL of the deployed app (used in influencer connect links and OAuth redirects) ---
APP_URL="https://your-app.vercel.app"

# --- Sign-in (Auth.js, Google, restricted to one company domain) ---
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
ALLOWED_EMAIL_DOMAIN="demokrito.com"
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI: https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Local development only. Ignored when NODE_ENV=production.
# AUTH_DEV_LOGIN=1

# --- Instagram data: "mock" = simulated demo data, "graph" = real Meta Graph API ---
METRICS_PROVIDER=mock

# Needed when METRICS_PROVIDER=graph  (see README, "Going live")
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"
# The Instagram Business/Creator account that makes the Business Discovery calls
IG_USER_ID=""
IG_ACCESS_TOKEN=""

# 32-byte hex key that encrypts influencers' stored access tokens.  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Secret for the scheduled refresh endpoint /api/cron/sync (Vercel Cron sends it automatically)
CRON_SECRET=""
